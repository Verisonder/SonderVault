<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device, so both transports exclude everything. allowBackup="false"
    already covers this on every version that matters; these rules exist so a future
    change to that attribute cannot quietly start copying the vault to the cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
