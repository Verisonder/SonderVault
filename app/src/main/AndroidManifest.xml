<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No INTERNET permission, and that is the load-bearing one. Nothing in this app can
        send anything anywhere, whatever the code says, so the promise that photos stay on
        the device does not rest on anyone reading the source and believing it.

        The media permissions exist so importing can take the original away. Leaving a
        photo sitting in the gallery after hiding it defeats the point, and Android will
        not let an app delete media it did not create without read access to it. Files
        picked through the document picker still need no permission at all.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!--
        Declared so Android 14 and above hands back a clear partial grant rather than
        behaving unpredictably. The app cannot work on a partial grant — it has to show
        the whole library and delete originals — so it detects one and says so instead of
        asking again in a loop.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        The special one. Granted by a toggle in Settings rather than a popup, and only
        when the user goes and finds it. With it, deleting an original happens silently;
        without it Android shows one confirmation per import. The app works either way and
        never insists.
    -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />

    <!--
        For reading a shared file's code off a QR, and nothing else. Asked for the first
        time the scanner is opened, never at launch, and the code can always be typed
        instead. There is no INTERNET permission, so a camera frame has nowhere to go
        even if something went wrong with it.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SonderLockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonderLock">

        <!--
            allowBackup is false because cloud backup would copy the vault off the
            device, which is the one thing this app exists to prevent. The encryption
            would hold, but the copy would exist, and the promise is that it does not.

            hasFragileUserData asks the user on uninstall whether to keep the app's data.
            Uninstalling otherwise destroys the vault silently and there is no way back
            without an exported bundle, so the prompt is worth the one extra tap.
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.SonderLock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
