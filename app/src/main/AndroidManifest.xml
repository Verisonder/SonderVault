<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions are declared, and that is the point.

        There is no INTERNET permission, so nothing in this app can send anything
        anywhere, whatever the code says. Importing uses the system photo picker and the
        storage access framework, both of which hand back a single chosen item and
        neither of which needs a permission. An app that cannot read the gallery and
        cannot reach the network has very little it can do wrong.

        Adding a permission here is therefore a decision worth arguing about, not a
        detail. If one ever becomes necessary, say so in the release notes.
    -->

    <application
        android:name=".SonderLockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonderLock">

        <!--
            allowBackup is false because cloud backup would copy the vault off the
            device, which is the one thing this app exists to prevent. The encryption
            would hold, but the copy would exist, and the promise is that it does not.

            hasFragileUserData asks the user on uninstall whether to keep the app's data.
            Uninstalling otherwise destroys the vault silently and there is no way back
            without an exported bundle, so the prompt is worth the one extra tap.
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.SonderLock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
